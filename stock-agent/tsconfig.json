{
    "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",
      "moduleResolution": "Bundler",
  
      "baseUrl": ".",
      "paths": {
        "@/*": ["src/*"]
      },
  
      "allowSyntheticDefaultImports": true,
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true
    },
    "include": ["src"]
  }
